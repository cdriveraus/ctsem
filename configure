#! /bin/sh

# Generated by rstantools.  Do not edit by hand.
# --- ctsem addition (not from rstantools) ---
# Snapshot the existing src/Makevars before rstan_config() rewrites it, so an
# unchanged file can keep its old mtime (restored at the foot of this script).
#
# Why: pkgbuild counts src/Makevars* as a header (pkgbuild:::headers), and
# pkgbuild:::needs_clean() is "any header newer than src/<pkg>.dll" -- when it
# is true, compile_dll() passes --preclean, which runs shlib-clean and deletes
# every object in src/, forcing a full stan recompile. rstan_config() rewrites
# src/Makevars on every run now, because the rules appended below make it
# differ from rstantools' own template, so its mtime moved on every install and
# roughly every second devtools/RStudio build rebuilt all of stan from scratch.
# Content is what matters here, not the timestamp; restoring the mtime when the
# bytes are unchanged makes the file look as untouched as it actually is.
_ctsem_mkv=src/Makevars
_ctsem_prev=src/Makevars.ctsem-prev
rm -f "$_ctsem_prev"
if [ -f "$_ctsem_mkv" ]; then
  cp -p "$_ctsem_mkv" "$_ctsem_prev" 2>/dev/null || rm -f "$_ctsem_prev"
fi

"${R_HOME}/bin/Rscript" -e "rstantools::rstan_config()"

# --- ctsem addition (not from rstantools) ---
# rstan_config() (above) regenerates src/Makevars from a fixed rstantools
# template on every configure run -- see rstantools:::.setup_Makevars /
# .add_stanfile, which rewrite the file whenever it already carries the
# "Generated by rstantools" marker, which it always does. So a dependency
# line cannot live inside that generated file across installs; it has to be
# re-appended here, after rstan_config() runs and before compilation starts.
#
# Without it: stanExports_X.cc is a thin, model-name-only wrapper around
# stanExports_X.h, so editing a .stan file's data/parameters and rebuilding
# regenerates X.h with new content (new mtime) while X.cc is byte-identical
# to before and rstantools' own content-diffing leaves its mtime untouched.
# make's only rule for the object is R's own old-style suffix rule (.cc.o:,
# from Makeconf), which sees no change and reuses the stale stanExports_X.o
# -- silently linking a model built from an old data layout, which reads
# exactly like a code bug rather than a build one.
#
# One rule per model, by literal name -- not a `%` pattern rule. Proved by
# direct reproduction against Rtools' GNU Make: a prerequisite-only PATTERN
# rule (stanExports_%.o: stanExports_%.h) is silently ignored when the
# target is actually built via an old-style SUFFIX rule (.cc.o:, what
# Makeconf uses), because make's suffix-rule and pattern-rule mechanisms
# don't combine for that purpose -- "make: Nothing to be done" even though
# the header is newer. An explicit-name rule (stanExports_ctsm.o:
# stanExports_ctsm.h) combines with a suffix rule correctly and does trigger
# the rebuild. See dev/stan-header-deps.md for the reproduction.
#
# The model list is read from inst/stan/*.stan at configure time, so a
# future added/removed .stan file needs no matching edit here.
if [ -f src/Makevars ]; then
  for _ctsem_stanfile in inst/stan/*.stan; do
    [ -f "$_ctsem_stanfile" ] || continue
    _ctsem_model=$(basename "$_ctsem_stanfile" .stan)
    _ctsem_rule="stanExports_${_ctsem_model}.o: stanExports_${_ctsem_model}.h"
    if ! grep -qF "$_ctsem_rule" src/Makevars; then
      {
        echo ''
        echo "# ctsem: rebuild stanExports_${_ctsem_model}.o when its generated header changes (see configure)"
        echo "$_ctsem_rule"
      } >> src/Makevars
    fi
  done
  unset _ctsem_stanfile _ctsem_model _ctsem_rule
  # Restore the default goal. R prepends src/Makevars to the makefile list
  # (tools:::.shlib_internal builds `makefiles <- c("Makevars", makefiles)`), so the
  # FIRST explicit target in it becomes make's default goal, and R invokes make
  # without naming one. The rules above would therefore make
  # the first model's object the goal: make builds that single object, prints
  # "Nothing to be done", exits 0, and R CMD INSTALL runs happily to the end
  # and fails only at the load check with no shared object. Verified with
  # make -p on a real generated Makevars, and reproduced minimally.
  #
  # This only bites a build starting from nothing -- a source install, or a
  # freshly shipped tree -- because a tree that already has every object still
  # links successfully after building one. That is why it passed a targeted
  # rebuild on Windows and failed three times from scratch on Linux.
  if ! grep -qF '.DEFAULT_GOAL := all' src/Makevars; then
    {
      echo ''
      echo '# ctsem: the rules above must not become the default goal (see configure)'
      echo '.DEFAULT_GOAL := all'
    } >> src/Makevars
  fi
fi

# Restore the mtime snapshotted at the top of this script when the regenerated
# src/Makevars is byte-identical to the previous one, so an unchanged build
# configuration does not read as newer than the dll built from it. Degrades
# safely: if cmp or touch is unavailable the file simply keeps its new mtime,
# which is the behaviour before this block existed.
if [ -f "$_ctsem_prev" ]; then
  if cmp -s "$_ctsem_mkv" "$_ctsem_prev" 2>/dev/null; then
    touch -r "$_ctsem_prev" "$_ctsem_mkv" 2>/dev/null
  fi
  rm -f "$_ctsem_prev"
fi
unset _ctsem_mkv _ctsem_prev
