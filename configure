#! /bin/sh

# Generated by rstantools.  Do not edit by hand.
"${R_HOME}/bin/Rscript" -e "rstantools::rstan_config()"

# --- ctsem addition (not from rstantools) ---
# Remove a stan object whose generated header is newer than it, so that make
# rebuilds it.
#
# stanExports_X.cc is a thin, model-name-only wrapper around stanExports_X.h.
# Editing a .stan file's data or parameters block regenerates X.h with new
# content while X.cc stays byte-identical, and rstantools' own content-diffing
# then leaves X.cc's mtime untouched. make's only rule for the object is R's
# old-style suffix rule (.cc.o:, from Makeconf), which sees no change and
# relinks the stale object built from the old data layout. Nothing errors; the
# symptom is a data-dimension mismatch at fit time that reads exactly like a
# code bug rather than a build one.
#
# The check belongs here, in the step that regenerates the header, and not as
# a dependency inside src/Makevars. Do not move it back there: every
# version of that went wrong, in three separate ways, all documented in
# dev/stan-header-deps.md. In short -- a prerequisite-only `%` pattern rule is
# silently ignored for a target make builds via a suffix rule; an explicit-name
# rule becomes make's default goal, because R prepends Makevars to the makefile
# list, which turns a from-scratch install into a no-op that fails only at the
# load check; and any edit at all makes rstantools rewrite Makevars on every
# configure run, whose moved mtime makes pkgbuild pass --preclean and wipe all
# of src/ -- a full stan recompile roughly every second devtools or RStudio
# build, since pkgbuild counts src/Makevars* as a header.
#
# Leaving the generated Makevars byte-identical to rstantools' template also
# keeps pkgbuild's own staleness check useful: it still precleans when a real
# header, such as one in inst/include, is newer than the built dll.
#
# The model list comes from inst/stan/*.stan at configure time, so an added or
# removed .stan file needs no matching edit here.
for _ctsem_stanfile in inst/stan/*.stan; do
  [ -f "$_ctsem_stanfile" ] || continue
  _ctsem_model=$(basename "$_ctsem_stanfile" .stan)
  _ctsem_obj="src/stanExports_${_ctsem_model}.o"
  _ctsem_hdr="src/stanExports_${_ctsem_model}.h"
  [ -f "$_ctsem_obj" ] && [ -f "$_ctsem_hdr" ] || continue
  if [ -n "$(find "$_ctsem_hdr" -newer "$_ctsem_obj" 2>/dev/null)" ]; then
    echo "ctsem: $_ctsem_hdr is newer than $_ctsem_obj -- removing the object so it rebuilds"
    rm -f "$_ctsem_obj"
  fi
done
unset _ctsem_stanfile _ctsem_model _ctsem_obj _ctsem_hdr
